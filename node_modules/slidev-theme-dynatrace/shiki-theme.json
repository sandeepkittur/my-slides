{
  "name": "dynatrace-light",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#2f2f4f",
    "editorLineNumber.foreground": "#9898b2",
    "editorLineNumber.activeForeground": "#2f2f4f",
    "editorIndentGuide.background": "#dadbe4",
    "editor.lineHighlightBackground": "#e8e8ef"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#545586", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#086467" }
    },
    {
      "scope": ["string.template variable", "string.template punctuation.definition"],
      "settings": { "foreground": "#2754b5" }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.operator", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#8136a9", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
      "settings": { "foreground": "#2754b5" }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "#2754b5" }
    },
    {
      "scope": ["variable.language.this", "variable.language.self"],
      "settings": { "foreground": "#8136a9" }
    },
    {
      "scope": ["constant.numeric", "constant.language.numeric"],
      "settings": { "foreground": "#aa0081" }
    },
    {
      "scope": ["constant.language.boolean", "constant.language.true", "constant.language.false"],
      "settings": { "foreground": "#973f00" }
    },
    {
      "scope": ["constant.language.null", "constant.language.undefined"],
      "settings": { "foreground": "#973f00" }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.class"],
      "settings": { "foreground": "#2c2d4d", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#b30926" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#973f00" }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#8136a9" }
    },
    {
      "scope": ["support.type.property-name", "meta.property-name"],
      "settings": { "foreground": "#2c2d4d" }
    },
    {
      "scope": ["meta.import", "keyword.control.import", "keyword.control.from"],
      "settings": { "foreground": "#8136a9", "fontStyle": "bold" }
    }
  ]
}
